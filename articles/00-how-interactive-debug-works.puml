@startuml

hide footbox

actor User
participant "Debugger Frontend" as FE
participant "Debugger Backend" as BE
participant "Tracee" as TP

' godbg attach <pid>
activate User #ff0000

User -> BE : input `godbg attach <pid>`
activate User #ffff00

activate BE #ff0000

BE -> BE: d := debugger.New(pid,...)\nd.Attach(pid,...)
activate BE #ffff00
deactivate BE

BE -> TP: syscall `ptrace(PTRACE_ATTACH, pid, nil, nil)`
activate BE #ffff00
activate TP #ff0000
TP -> TP: kernel process PTRACE syscall:\n1. task_struct.ptrace = TRACED\n2. send SIGTRAP to process
activate TP #ffff00
TP -> BE: ptrace returns
deactivate BE

BE -> TP: wait4(pid,status):\n1. ptracer `interruptible sleep`\n2. added to waiting list of tracee's state changed\n3. will be woken up by SIGCHILD
activate BE #ffff00

activate TP #00ffff

TP -> TP: SIGTRAP handler: \n1. stop the process\n2. send SIGCHLD to ptracer, \n    notify child process state changed\n3. __wake_up_parent(tsk, ptracer) called
TP -> BE: send SIGCHLD to ptracer \nps: but SIGCHLD may be not generated ❌,\n     so __wake_up_parent(tsk, ptracer) called
deactivate TP

activate BE #00ffff
BE -> BE: 1. wake up ptracer\n2. ptracer `interruptible sleep` to `runnable`\n3. scheduler shedules ptracer\n4. wait4(...) returns\n\nps: even if SIGCHLD not generated,\n__wake_up_parent(...) will wake up the ptracer,\n both of them could wake up ptracer.
deactivate BE

deactivate TP

TP -> BE: wait4 returns
deactivate BE

BE --> User: attach ok
deactivate User

' godbg> COMMAND [flags] [args]
BE -> BE : ln, _ := listen(ipport)\nconn, err := ln.accept()
activate BE #ffff00

activate FE #ff0000
FE -> BE: conn := net.Dial("tcp", ipport)
activate FE #ffff00
BE -> FE
deactivate FE

BE -> BE: nserveConn(conn)\nclient := rpc2.NewClientFromConn(conn)
deactivate BE

User -> FE: input `godbg> COMMAND [flags] [args]`
activate User #ffff00
activate FE #ffff00

FE -> BE: client.COMMAND(pid) over JSON-RPC
activate BE #ffff00

BE -> BE: jsonrpc.ReadRequest(&req)\nif req.Method = "Attach" then {\n    server.COMMAND(pid)\n}
BE -> TP: debugger.COMMAND1/2/3(pid, ...)
activate BE #00ffff

activate TP #ffff00
TP -> TP : kernel relevant processing
TP --> BE
deactivate TP

BE -> FE: return COMMAND response

FE -> User: display COMMAND result

deactivate BE

deactivate User

@enduml